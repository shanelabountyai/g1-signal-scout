# Names only; values never in the repo.
# G1·B (n8n)
N8N_API_KEY=
N8N_URL=http://localhost:5678
# G1·C (code)
ANTHROPIC_API_KEY=            # live model calls only when set (D-27); absent = recorded responses
SCOUT_DB_PATH=                # seen_items SQLite; default ~/.g1-signal-scout/scout.sqlite
G0_DB_PATH=                   # shared layer SQLite; default ~/.g0-shared-layer/layer.sqlite
G0_RUN_CAP_USD=10             # hard cap per run, enforced by G0 observability
SCOUT_DRIVE_SERVICE_ACCOUNT_JSON=   # path to the service-account key file (Drive sink, D-25)
SCOUT_DRIVE_FOLDER_ID=        # Drive folder shared with the service account
